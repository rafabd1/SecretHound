# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.py[cod]
__pycache__/
/secrethound

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Build directories
bin/
dist/

# IDE specific files
.idea/
.vscode/

# Local secrets or test files
output.json
output.txt
secrets.txt
*.env

# Go workspace file
go.work
go.work.sum

# env file
.env

dev/*
!dev/filesTest/
dev/filesTest/*
!dev/filesTest/semantic_benchmark/
!dev/filesTest/semantic_benchmark/**
!dev/filesTest/pii_benchmark/
!dev/filesTest/pii_benchmark/**
dev/filesTest/**/__pycache__/
dev/filesTest/**/*.pyc

output.*
output_*
/secrethound_results.*
/semantic-mock-*.json

.cursor

mailmap.txt

.gocache/
